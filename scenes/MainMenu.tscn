text = "[b]🎮 Controale:[/b]
[color=#aaaaaa]W[/color]  Mergi înainte     [color=#aaaaaa]S[/color]  Mergi înapoi
[color=#aaaaaa]A[/color]  Strafe stânga     [color=#aaaaaa]D[/color]  Strafe dreapta
[color=#ffff66]Mouse[/color]  Rotește privirea     [color=#ffff66]E[/color]  Interacționează     [color=#aaaaaa]ESC[/color]  Meniu

[b]🏆 Obiectiv:[/b] [color=#aaaaaa]Găsește [color=#00ff77]IEȘIREA[/color] din labirint înainte să rămâi fără vieți![/color]

[b]🎁 Obiecte:[/b]
[color=#33ccff]MINIMAP[/color] Deblochează harta    [color=#88ff88]BUSOLĂ[/color] Arată direcția ieșirii
[color=#ff4444]+VIAȚĂ[/color] Câștigă o viață    [color=#ff8800]CAPCANĂ[/color] Pierzi o viață imediat!
[color=#cc00ff]BLESTEM[/color] Timer — găsește ieșirea repede sau pierzi o viață"

